# Copy this file to .env and fill in the values.

# Get a free TMDB API key: https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (v4 bearer). Required for movies/TV data.
VITE_TMDB_TOKEN=

# Optional fallback: v3 API key (short one). Only needed if you don't use the token above.
VITE_TMDB_KEY=

# Optional — enables the live AI draft assistant (fantasy Draft Room).
# SERVER-SIDE ONLY: no VITE_ prefix, so it is never bundled into the browser.
# Read by api/draft-assistant.ts under `vercel dev` / on Vercel. Also add it in
# Vercel -> Settings -> Environment Variables for the deployed AI to work.
# ANTHROPIC_KEY works too — the handlers read either name (Vercel uses the short one).
ANTHROPIC_API_KEY=

# Optional — live Yahoo Fantasy data (the Jones Family League panels).
# From the app registered at developer.yahoo.com (Web Application, Fantasy Sports Read).
# Server-side only. Add these in Vercel -> Settings -> Environment Variables too.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Printed once by /api/yahoo/callback after you sign in at /api/yahoo/login. It doesn't
# expire — it IS the app's token storage (there's no database). Treat it like a password.
YAHOO_REFRESH_TOKEN=

# Optional. Pin the OAuth redirect if the host varies (must match Yahoo's app config
# byte-for-byte), and the default league. The app auto-discovers the live league key
# each season, so YAHOO_LEAGUE_KEY is only a fallback.
YAHOO_REDIRECT_URI=
YAHOO_LEAGUE_KEY=

# Optional — lock the AI assistant behind access codes (comma-separated).
# If set, callers must supply a matching code (Settings -> AI Access Code) or
# they're blocked. Give a tester their own code; remove it + redeploy to block
# just them. Leave blank to keep the AI open. Server-side only.
APP_ACCESS_CODES=
